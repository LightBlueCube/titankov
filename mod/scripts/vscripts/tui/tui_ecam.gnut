global function TuiEcam_Init

global function ECAM_Insert
global function ECAM_SetText
global function ECAM_SetSeverity
global function ECAM_Complete
global function ECAM_Reopen
global function ECAM_Collapse
global function ECAM_CollapseAll
global function ECAM_Delete
global function ECAM_Clear
global function ECAM_SetMemo
global function ECAM_ClearMemo
global function ECAM_SetSelectable
global function ECAM_SetInteractive
global function ECAM_MoveCursor
global function ECAM_GetCursor
global function ECAM_GetParent
global function ECAM_HasChildren
global function ECAM_IsCollapsed

// ECAM checklist lib
// usage:
//   int fire = ECAM_Insert( player, 0, "ENG 1 FIRE", eEcamSeverity.WARNING )
//   int step = ECAM_Insert( player, fire, "FIRE SWITCH", eEcamSeverity.INFO, "PULL" )
//   ECAM_Complete( player, step )
//   ECAM_Complete( player, fire, true )  // children complete too, auto collapse

global enum eEcamSeverity
{
	INFO = 0
	OK = 1
	ACTION = 2
	CAUTION = 3
	WARNING = 4
}

const int ECAM_COLS = 60
const int ECAM_ROWS = 34
const int ECAM_FONT_SIZE = 24
const float ECAM_POS_X = 0.28
const float ECAM_POS_Y = 0.26
const int ECAM_PRIORITY = 50

const int ECAM_INDENT_COLS = 2
const int ECAM_CONTENT_COLS = 58
const int ECAM_MEMO_MAX_ROWS = 6

// palette sampled from iniBuilds A350 ECAM textures (Data/Textures/ECAM)
const string ECAM_SGR_RESET = "\x1b[0m"
const string ECAM_SGR_PANEL_BG = "\x1b[48:6:22:24:30:150m"
const string ECAM_SGR_TITLE = "\x1b[1m\x1b[38;2;235;238;242m\x1b[48:6:56:62:70:230m"
const string ECAM_SGR_WARN_FG = "\x1b[1m\x1b[38;2;214;228;229m"
const string ECAM_SGR_WARN_BG = "\x1b[48:6:255:69:69:255m"
const string ECAM_SGR_CAUTION = "\x1b[1m\x1b[38;2;255;145;46m"
const string ECAM_SGR_INFO = "\x1b[38;2;198;217;219m"
const string ECAM_SGR_ACTION = "\x1b[38;2;57;189;214m"
const string ECAM_SGR_OK = "\x1b[38;2;39;216;26m"
const string ECAM_SGR_DIM = "\x1b[38;2;119;119;119m"
const string ECAM_SGR_MEMO = "\x1b[38;2;39;216;26m"

const string ECAM_SGR_SEL_BG = "\x1b[48:6:40:90:110:240m"

struct EcamNode
{
	int id = 0
	int parentId = 0
	string text = ""
	string target = ""
	int severity = 0
	bool done = false
	bool doneByParent = false
	bool collapsed = false
	int seq = 0
	int doneSeq = 0
	array<int> children = []
	bool selectable = false
}

struct EcamRowSeg
{
	string text = ""
	string fg = ""
}

struct EcamRow
{
	array<EcamRowSeg> segs = []
	int width = 0
	bool warn = false
	bool title = false
	bool selected = false
}

struct EcamMemoItem
{
	string text = ""
	int severity = 0
}

struct EcamPlayerState
{
	entity player
	int tuiIndex = -1
	int nextId = 1
	int seqCounter = 0
	int doneCounter = 0
	table<int, EcamNode> nodes = {}
	array<int> roots = []
	table<string, EcamMemoItem> memos = {}
	bool dirty = false
	bool interactive = false
	int cursor = 0
	int cursorRow = -1
}

table<string, EcamPlayerState> ecamPlayerStates = {}

void function TuiEcam_Init()
{
	AddCallback_OnClientConnected( EcamOnClientConnected )
	AddCallback_OnClientDisconnected( EcamOnClientDisconnected )
	AddCallback_OnPlayerRespawned( EcamOnPlayerRespawned )
}

void function EcamOnClientConnected( entity player )
{
	EcamPlayerState state = { ... }
	state.player = player
	state.tuiIndex = NSCreateTUI( player, ECAM_COLS, ECAM_ROWS, ECAM_FONT_SIZE, ECAM_POS_X, ECAM_POS_Y, ECAM_PRIORITY )
	ecamPlayerStates[ player.GetUID() ] <- state

	thread EcamThink( player )
}

void function EcamOnClientDisconnected( entity player )
{
	string uid = player.GetUID()
	if ( uid in ecamPlayerStates )
		delete ecamPlayerStates[ uid ]
}

void function EcamOnPlayerRespawned( entity player )
{
	thread EcamLifeSentry( player )
}

void function EcamLifeSentry( entity player )
{
	player.EndSignal( "OnDeath" )
	player.EndSignal( "OnDestroy" )

	OnThreadEnd(
		function() : ( player )
		{
			if ( !IsValid( player ) )
				return

			string uid = player.GetUID()
			if ( uid in ecamPlayerStates )
				EcamClearState( ecamPlayerStates[ uid ] )
		}
	)

	WaitForever()
}

void function EcamThink( entity player )
{
	player.EndSignal( "OnDestroy" )

	while ( true )
	{
		string uid = player.GetUID()
		if ( uid in ecamPlayerStates )
		{
			EcamPlayerState state = ecamPlayerStates[ uid ]
			if ( state.dirty )
			{
				state.dirty = false
				NSSendTUI( player, state.tuiIndex, EcamRenderFrame( state ) )
			}
		}
		WaitFrame()
	}
}

int function ECAM_Insert( entity player, int parentId, string text, int severity = eEcamSeverity.INFO, string target = "" )
{
	if ( severity < eEcamSeverity.INFO || severity > eEcamSeverity.WARNING )
		unreachable

	EcamPlayerState state = EcamGetState( player )

	if ( parentId != 0 )
	{
		EcamNode parentNode = EcamGetNode( state, parentId )
		if ( parentNode.done )
			unreachable
	}

	EcamNode node = { ... }
	node.id = state.nextId
	node.parentId = parentId
	node.text = text
	node.target = target
	node.severity = severity
	state.nextId++
	state.seqCounter++
	node.seq = state.seqCounter
	state.nodes[ node.id ] <- node

	if ( parentId == 0 )
		state.roots.append( node.id )
	else
		state.nodes[ parentId ].children.append( node.id )

	state.dirty = true
	return node.id
}

void function ECAM_SetText( entity player, int index, string text )
{
	if ( index == 0 )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )
	node.text = text
	state.dirty = true
}

void function ECAM_SetSeverity( entity player, int index, int severity )
{
	if ( index == 0 )
		unreachable
	if ( severity < eEcamSeverity.INFO || severity > eEcamSeverity.WARNING )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )
	node.severity = severity
	state.dirty = true
}

void function ECAM_Complete( entity player, int index, bool autoCollapse = true )
{
	if ( index == 0 )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )
	if ( node.done )
		unreachable

	EcamMarkDone( state, node )
	if ( autoCollapse )
		node.collapsed = true
	state.dirty = true
}

void function ECAM_Reopen( entity player, int index )
{
	if ( index == 0 )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )
	if ( !node.done )
		unreachable

	EcamReopenNode( state, node )
	node.collapsed = false
	state.dirty = true
}

void function ECAM_Collapse( entity player, int index, bool collapsed = true )
{
	if ( index == 0 )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )
	node.collapsed = collapsed
	state.dirty = true
}

// fold every open folder back up
void function ECAM_CollapseAll( entity player )
{
	EcamCollapseAllNodes( EcamGetState( player ) )
}

void function EcamCollapseAllNodes( EcamPlayerState state )
{
	foreach ( int id, EcamNode node in state.nodes )
	{
		if ( node.collapsed || node.children.len() == 0 )
			continue
		node.collapsed = true
		state.dirty = true
	}
}

void function ECAM_Delete( entity player, int index )
{
	if ( index == 0 )
		unreachable

	EcamPlayerState state = EcamGetState( player )
	EcamNode node = EcamGetNode( state, index )

	if ( node.parentId == 0 )
		state.roots.removebyvalue( index )
	else
		state.nodes[ node.parentId ].children.removebyvalue( index )

	EcamDeleteSubtree( state, node )
	state.dirty = true
}

void function ECAM_Clear( entity player )
{
	string uid = player.GetUID()
	if ( !( uid in ecamPlayerStates ) )
		return

	EcamClearState( ecamPlayerStates[ uid ] )
}

// Memos are keyed status lines pinned under the checklist.
// Empty text keeps the current text, so a caller can change only the severity.
void function ECAM_SetMemo( entity player, string key, string text, int severity = eEcamSeverity.INFO )
{
	if ( severity < eEcamSeverity.INFO || severity > eEcamSeverity.WARNING )
		unreachable

	EcamPlayerState state = EcamGetState( player )

	if ( key in state.memos )
	{
		EcamMemoItem memo = state.memos[ key ]
		if ( text == "" )
			text = memo.text

		// callers poll every tick; only resend the frame on real changes
		if ( memo.text == text && memo.severity == severity )
			return

		memo.text = text
		memo.severity = severity
	}
	else
	{
		EcamMemoItem memo = { ... }
		memo.text = text
		memo.severity = severity
		state.memos[ key ] <- memo
	}

	state.dirty = true
}

void function ECAM_ClearMemo( entity player, string key )
{
	EcamPlayerState state = EcamGetState( player )
	if ( !( key in state.memos ) )
		return

	delete state.memos[ key ]
	state.dirty = true
}

// ---- interactive mode: a cursor over selectable nodes; the caller decides what a node does ----

void function ECAM_SetSelectable( entity player, int index, bool selectable = true )
{
	EcamPlayerState state = EcamGetState( player )
	EcamGetNode( state, index ).selectable = selectable
	state.dirty = true
}

void function ECAM_SetInteractive( entity player, bool interactive )
{
	EcamPlayerState state = EcamGetState( player )
	if ( state.interactive == interactive )
		return
	state.interactive = interactive
	if ( !interactive )
		EcamCollapseAllNodes( state )	// closing the panel folds every open submenu
	state.dirty = true
}

void function ECAM_MoveCursor( entity player, int delta )
{
	EcamPlayerState state = EcamGetState( player )
	EcamFixCursor( state )
	array<int> visible = EcamVisibleSelectable( state )
	if ( visible.len() == 0 )
		return

	int at = 0
	for ( int i = 0; i < visible.len(); i++ )
	{
		if ( visible[ i ] == state.cursor )
		{
			at = i
			break
		}
	}
	at += delta
	if ( at < 0 )
		at = 0
	if ( at >= visible.len() )
		at = visible.len() - 1

	state.cursor = visible[ at ]
	state.dirty = true
}

// 0 when not interactive or nothing is selectable
int function ECAM_GetCursor( entity player )
{
	string uid = player.GetUID()
	if ( !( uid in ecamPlayerStates ) )
		return 0
	EcamPlayerState state = ecamPlayerStates[ uid ]
	if ( !state.interactive )
		return 0
	EcamFixCursor( state )
	return state.cursor
}

int function ECAM_GetParent( entity player, int index )
{
	return EcamGetNode( EcamGetState( player ), index ).parentId
}

bool function ECAM_HasChildren( entity player, int index )
{
	return EcamGetNode( EcamGetState( player ), index ).children.len() > 0
}

bool function ECAM_IsCollapsed( entity player, int index )
{
	return EcamGetNode( EcamGetState( player ), index ).collapsed
}

// keep the cursor on a visible selectable node: nearest visible selectable ancestor, else the first one
void function EcamFixCursor( EcamPlayerState state )
{
	array<int> visible = EcamVisibleSelectable( state )
	int id = state.cursor
	while ( id != 0 && ( id in state.nodes ) )
	{
		if ( visible.contains( id ) )
		{
			state.cursor = id
			return
		}
		id = state.nodes[ id ].parentId
	}
	state.cursor = visible.len() > 0 ? visible[ 0 ] : 0
}

// same walk order as EcamLayoutNode
array<int> function EcamVisibleSelectable( EcamPlayerState state )
{
	array<int> out = []
	foreach ( int id in EcamSortIds( state, state.roots ) )
		EcamCollectVisible( state, id, out )
	return out
}

void function EcamCollectVisible( EcamPlayerState state, int id, array<int> out )
{
	EcamNode node = state.nodes[ id ]
	if ( node.selectable )
		out.append( id )
	if ( node.collapsed )
		return
	foreach ( int childId in EcamSortIds( state, node.children ) )
		EcamCollectVisible( state, childId, out )
}

EcamPlayerState function EcamGetState( entity player )
{
	string uid = player.GetUID()
	if ( uid in ecamPlayerStates )
		return ecamPlayerStates[ uid ]

	unreachable
}

EcamNode function EcamGetNode( EcamPlayerState state, int index )
{
	if ( index in state.nodes )
		return state.nodes[ index ]

	unreachable
}

void function EcamClearState( EcamPlayerState state )
{
	state.nodes = {}
	state.roots = []
	state.memos = {}
	state.dirty = true
}

void function EcamMarkDone( EcamPlayerState state, EcamNode node )
{
	node.done = true
	state.doneCounter++
	node.doneSeq = state.doneCounter

	foreach ( int childId in node.children )
	{
		EcamNode child = state.nodes[ childId ]
		if ( !child.done )
		{
			child.doneByParent = true
			EcamMarkDone( state, child )
		}
	}
}

void function EcamReopenNode( EcamPlayerState state, EcamNode node )
{
	node.done = false
	node.doneByParent = false
	node.doneSeq = 0

	foreach ( int childId in node.children )
	{
		EcamNode child = state.nodes[ childId ]
		if ( child.done && child.doneByParent )
			EcamReopenNode( state, child )
	}
}

void function EcamDeleteSubtree( EcamPlayerState state, EcamNode node )
{
	foreach ( int childId in node.children )
		EcamDeleteSubtree( state, state.nodes[ childId ] )

	delete state.nodes[ node.id ]
}

array<int> function EcamSortIds( EcamPlayerState state, array<int> ids )
{
	array<int> sorted = []
	foreach ( int id in ids )
	{
		int insertAt = sorted.len()
		for ( int i = 0; i < sorted.len(); i++ )
		{
			if ( EcamNodeOrder( state, id, sorted[ i ] ) )
			{
				insertAt = i
				break
			}
		}
		sorted.insert( insertAt, id )
	}
	return sorted
}

bool function EcamNodeOrder( EcamPlayerState state, int aId, int bId )
{
	EcamNode a = state.nodes[ aId ]
	EcamNode b = state.nodes[ bId ]

	if ( a.done != b.done )
		return !a.done
	if ( a.done )
		return a.doneSeq <= b.doneSeq
	if ( a.severity != b.severity )
		return a.severity > b.severity
	return a.seq <= b.seq
}

string function EcamRenderFrame( EcamPlayerState state )
{
	if ( state.roots.len() == 0 && state.memos.len() == 0 )
		return ""

	if ( state.interactive )
		EcamFixCursor( state )
	state.cursorRow = -1

	// memos are pinned to the bottom, the checklist gets the remaining rows
	array<EcamRow> memoRows = EcamLayoutMemos( state )
	int checklistRows = ECAM_ROWS - 1
	if ( memoRows.len() > 0 )
		checklistRows -= memoRows.len() + 1

	array<EcamRow> rows = []

	EcamRow titleRow = { ... }
	titleRow.title = true
	EcamAppendSeg( titleRow, state.interactive ? "ECAM  W/S移动 D执行 A折叠 长按E退出" : "ECAM", "" )
	rows.append( titleRow )

	array<EcamRow> nodeRows = []
	foreach ( int id in EcamSortIds( state, state.roots ) )
		EcamLayoutNode( state, id, 0, nodeRows )

	if ( nodeRows.len() > checklistRows )
	{
		int keep = checklistRows - 1
		int hiddenCount = nodeRows.len() - keep
		// interactive: scroll so the cursor row stays on screen
		int start = 0
		if ( state.cursorRow >= keep )
			start = state.cursorRow - keep + 1
		array<EcamRow> window = []
		for ( int i = start; i < start + keep; i++ )
			window.append( nodeRows[ i ] )
		nodeRows = window

		EcamRow moreRow = { ... }
		string moreText = "... " + format( "+%d MORE", hiddenCount )
		EcamAppendSeg( moreRow, moreText, ECAM_SGR_CAUTION )
		moreRow.width = TuiText_Width( moreText )
		nodeRows.append( moreRow )
	}
	rows.extend( nodeRows )

	if ( memoRows.len() > 0 )
	{
		EcamRow sepRow = { ... }
		EcamAppendSeg( sepRow, TuiText_Repeat( "─", ECAM_CONTENT_COLS ), ECAM_SGR_DIM )
		sepRow.width = ECAM_CONTENT_COLS
		rows.append( sepRow )
		rows.extend( memoRows )
	}

	string frame = ""
	for ( int i = 0; i < rows.len(); i++ )
	{
		if ( i > 0 )
			frame += "\n"
		frame += EcamComposeRow( rows[ i ] )
	}
	return frame
}

void function EcamLayoutNode( EcamPlayerState state, int id, int depth, array<EcamRow> rows )
{
	EcamNode node = state.nodes[ id ]

	int indent = depth * ECAM_INDENT_COLS
	int avail = ECAM_CONTENT_COLS - indent - 2
	if ( avail < 8 )
		avail = 8

	bool hasChildren = node.children.len() > 0
	bool hasCount = hasChildren && node.collapsed
	string countText = hasCount ? format( " (%d)", node.children.len() ) : ""
	int countWidth = hasCount ? TuiText_Width( countText ) : 0

	array<string> lines = TuiText_Wrap( node.text, avail )
	if ( lines.len() == 0 )
		lines.append( "" )

	bool alignedTarget = false
	if ( node.target != "" )
	{
		if ( lines.len() == 1 )
		{
			int used = indent + 2 + TuiText_Width( lines[ 0 ] ) + countWidth
			if ( used + 2 + TuiText_Width( node.target ) <= ECAM_CONTENT_COLS )
				alignedTarget = true
		}
		if ( !alignedTarget )
		{
			string merged = node.text
			if ( merged != "" )
				merged += "  "
			merged += node.target
			lines = TuiText_Wrap( merged, avail )
			if ( lines.len() == 0 )
				lines.append( "" )
		}
	}

	bool warn = !node.done && node.severity == eEcamSeverity.WARNING
	string fg = warn ? "" : EcamNodeFg( node )
	string targetFg = node.done ? ECAM_SGR_OK : fg

	bool selected = state.interactive && state.cursor == id
	for ( int i = 0; i < lines.len(); i++ )
	{
		EcamRow row = { ... }
		row.warn = warn
		row.selected = selected
		string line = lines[ i ]
		int width = indent + 2 + TuiText_Width( line )

		if ( i == 0 )
		{
			EcamAppendSeg( row, TuiText_Spaces( indent ), "" )
			string marker = "  "
			if ( hasChildren )
				marker = node.collapsed ? "+ " : "- "
			EcamAppendSeg( row, marker, fg )
			EcamAppendSeg( row, line, fg )
		}
		else
		{
			EcamAppendSeg( row, TuiText_Spaces( indent + 2 ), "" )
			EcamAppendSeg( row, line, fg )
		}

		bool isLast = i == lines.len() - 1
		if ( isLast && hasCount )
		{
			EcamAppendSeg( row, countText, warn ? "" : ECAM_SGR_DIM )
			width += countWidth
		}

		if ( isLast && alignedTarget )
		{
			int targetWidth = TuiText_Width( node.target )
			int dots = ECAM_CONTENT_COLS - width - targetWidth - 2
			if ( dots > 0 )
				EcamAppendSeg( row, " " + TuiText_Repeat( ".", dots ) + " ", warn ? "" : fg )
			else
				EcamAppendSeg( row, "  ", warn ? "" : fg )
			EcamAppendSeg( row, node.target, warn ? "" : targetFg )
			width = ECAM_CONTENT_COLS
		}

		row.width = width
		if ( selected && i == 0 )
			state.cursorRow = rows.len()
		rows.append( row )
	}

	if ( !node.collapsed )
	{
		foreach ( int childId in EcamSortIds( state, node.children ) )
			EcamLayoutNode( state, childId, depth + 1, rows )
	}
}

string function EcamNodeFg( EcamNode node )
{
	if ( node.done )
		return ECAM_SGR_OK
	if ( node.severity == eEcamSeverity.WARNING )
		return ECAM_SGR_WARN_FG
	if ( node.severity == eEcamSeverity.CAUTION )
		return ECAM_SGR_CAUTION
	if ( node.severity == eEcamSeverity.OK )
		return ECAM_SGR_OK
	if ( node.severity == eEcamSeverity.ACTION )
		return ECAM_SGR_ACTION
	return ECAM_SGR_INFO
}

// severity high to low, then key order, capped at ECAM_MEMO_MAX_ROWS
array<EcamRow> function EcamLayoutMemos( EcamPlayerState state )
{
	array<string> keys = []
	foreach ( string key, EcamMemoItem memo in state.memos )
		keys.append( key )

	keys.sort( int function( string a, string b ) : ( state ) {
		EcamMemoItem memoA = state.memos[ a ]
		EcamMemoItem memoB = state.memos[ b ]
		if ( memoA.severity != memoB.severity )
			return memoB.severity - memoA.severity
		if ( a < b )
			return -1
		if ( a > b )
			return 1
		return 0
	} )

	array<EcamRow> rows = []
	foreach ( string key in keys )
	{
		EcamMemoItem memo = state.memos[ key ]
		string fg = EcamMemoFg( memo.severity )

		foreach ( string line in TuiText_Wrap( memo.text, ECAM_CONTENT_COLS ) )
		{
			if ( rows.len() >= ECAM_MEMO_MAX_ROWS )
				return rows

			EcamRow row = { ... }
			EcamAppendSeg( row, line, fg )
			row.width = TuiText_Width( line )
			rows.append( row )
		}
	}
	return rows
}

string function EcamMemoFg( int severity )
{
	if ( severity == eEcamSeverity.WARNING )
		return ECAM_SGR_WARN_FG
	if ( severity == eEcamSeverity.CAUTION )
		return ECAM_SGR_CAUTION
	if ( severity == eEcamSeverity.OK )
		return ECAM_SGR_OK
	if ( severity == eEcamSeverity.ACTION )
		return ECAM_SGR_ACTION
	return ECAM_SGR_MEMO
}

string function EcamComposeRow( EcamRow row )
{
	if ( row.title )
	{
		string title = row.segs.len() > 0 ? row.segs[ 0 ].text : "ECAM"
		int titlePad = ECAM_CONTENT_COLS - TuiText_Width( title )
		if ( titlePad < 0 )
			titlePad = 0
		return ECAM_SGR_TITLE + " " + title + TuiText_Spaces( titlePad ) + " " + ECAM_SGR_RESET
	}

	if ( row.selected )
	{
		string sel = ECAM_SGR_SEL_BG + " "
		foreach ( EcamRowSeg seg in row.segs )
			sel += ( seg.fg == "" ? ECAM_SGR_WARN_FG : seg.fg ) + seg.text
		int selPad = ECAM_CONTENT_COLS - row.width
		if ( selPad < 0 )
			selPad = 0
		return sel + TuiText_Spaces( selPad ) + " " + ECAM_SGR_RESET
	}

	if ( row.warn )
	{
		string text = ""
		foreach ( EcamRowSeg seg in row.segs )
			text += seg.text
		int pad = ECAM_CONTENT_COLS - row.width
		if ( pad < 0 )
			pad = 0
		return ECAM_SGR_WARN_FG + ECAM_SGR_WARN_BG + " " + text + TuiText_Spaces( pad ) + " " + ECAM_SGR_RESET
	}

	string out = ECAM_SGR_PANEL_BG + " "
	foreach ( EcamRowSeg seg in row.segs )
		out += seg.fg + seg.text
	int pad = ECAM_CONTENT_COLS - row.width
	if ( pad < 0 )
		pad = 0
	out += TuiText_Spaces( pad ) + " " + ECAM_SGR_RESET
	return out
}

void function EcamAppendSeg( EcamRow row, string text, string fg )
{
	EcamRowSeg seg = { ... }
	seg.text = text
	seg.fg = fg
	row.segs.append( seg )
}

